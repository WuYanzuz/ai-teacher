# ============================================================
#  .env.example  —  仅放占位符, 真实 key 放在 .env (并被 .gitignore 忽略)
# ============================================================

# === 火山引擎 (主账号, 一个 key 解决多模态 + 文本) ===
# 开通: https://www.volcengine.com/product/ark
# 1) 开通"方舟"服务, 创建一个 API Key
# 2) 在"在线推理"创建一个接入点:
#    - 视觉:  doubao-1-5-vision-pro-32k  (或多模态其他模型)
#    - 文本:  deepseek-v3 / deepseek-r1 等
# 3) 把接入点的 model id 填到下面 config.yaml
VOLC_API_KEY=your-volcengine-api-key-here

# 火山方舟有两个 base URL:
#   /api/v3      - 标准方舟 (按量付费)
#   /api/plan/v3 - Agent Plan / 企业套餐 (同时支持 Anthropic 和 OpenAI 协议)
# Agent Plan 用户的 key 通常对应 /api/plan/v3
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# === 阿里 DashScope (备选, 不用可留空) ===
# 如果用豆包视觉, 这里的 key 留空即可
# 仅当你想切回 Qwen-VL 或用 Paraformer 语音识别时才需要填
DASHSCOPE_API_KEY=

# === DeepSeek 官方 (备选) ===
# 火山方舟上的 DeepSeek 通常更稳定; 用官方也可以
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 微信机器人配置 ===
# 机器人登录的微信号 (单独养的小号, 不要用老师主号)
WCF_ROBOT_NICKNAME=AI批改小助手

# 监听的群 (roomid, 多个用逗号分隔)
WCF_WHITELIST_GROUPS=1234567890@chatroom

# 指定老师 wxid (私聊接收点评)
WCF_TEACHER_WXID=wxid_teacher

# === 业务配置 ===
# 每户每日最大处理次数
MAX_PER_PARENT_PER_DAY=5
# 每日机器人总消息上限 (防封)
MAX_TOTAL_PER_DAY=80
# 媒体临时文件保留天数
CACHE_RETENTION_DAYS=30
# 夜里不打扰 (22-7 点)
QUIET_HOUR_START=22
QUIET_HOUR_END=7
