.feedback {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2A2A2A;
  white-space: pre-wrap;
}

.empty-inline {
  padding: 32rpx 0;
  font-size: 26rpx;
}

.rep-card .rep-preview {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ck-line {
  font-size: 27rpx;
  line-height: 1.9;
}

.ck-label {
  color: #5B6BCE;
  margin-right: 12rpx;
}

.ck-opts {
  color: #2A2A2A;
}

.ck-note {
  color: #6B7280;
  font-size: 25rpx;
}

.ck-daynote {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
  background: #F4F6FA;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}
