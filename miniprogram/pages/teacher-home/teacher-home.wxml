<view class="container">
  <view class="card">
    <view class="title">新建班级</view>
    <input class="input" placeholder="例如: 小一班" value="{{newName}}" bindinput="onInputName" />
    <view class="btn-primary" bindtap="onCreate">创建班级</view>
  </view>

  <view class="title" style="margin-top:40rpx;">我管理的班级</view>

  <view wx:if="{{!classes.length}}" class="empty">还没有班级, 上面创建一个吧</view>

  <view wx:for="{{classes}}" wx:key="id" class="card class-card" data-id="{{item.id}}" bindtap="onOpenClass">
    <view class="row">
      <view class="col">
        <view class="title">{{item.name}}</view>
        <view class="subtitle">{{item.member_count}} 名学生</view>
      </view>
      <view class="col" style="align-items:flex-end;">
        <view class="join-code" data-code="{{item.code}}" catchtap="onCopyCode">{{item.code}}</view>
        <view class="subtitle" style="font-size:22rpx;">点击复制</view>
      </view>
    </view>
  </view>

  <view class="card" style="margin-top:60rpx;text-align:center;" bindtap="onLogout">
    <text style="color:#9CA3AF;">退出登录</text>
  </view>
</view>
