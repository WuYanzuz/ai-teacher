.media {
  width: 100%;
  background: #F4F6FA;
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 12rpx;
}
.media image { width: 100%; display: block; }
.media-video {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000;
}
.transcript {
  font-size: 28rpx;
  line-height: 1.6;
  color: #4B5563;
  background: #F4F6FA;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}
.feedback {
  font-size: 30rpx;
  line-height: 1.7;
  color: #2A2A2A;
  white-space: pre-wrap;
  margin-top: 8rpx;
}
.actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.actions > view { flex: 1; }
.modal-mask {
  position: fixed; left:0; right:0; top:0; bottom:0;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.modal {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 80%;
}
.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F4F6FA;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.edit-row {
  display: flex;
  margin-top: 20rpx;
}
.edit-row > view { flex: 1; }
.edited-tag {
  background: #FEF3C7;
  color: #92400E;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
