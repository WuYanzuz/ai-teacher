.entry-card {
  flex: 1;
  margin-bottom: 0;
  text-align: center;
  padding: 28rpx 0;
}
.entry-emoji { font-size: 52rpx; line-height: 1.2; }
.entry-label { font-size: 28rpx; color: #2A2A2A; margin-top: 8rpx; }

.filter-card { padding: 20rpx 24rpx; }
.filter-input { margin-bottom: 0; }
.hw-card { padding: 24rpx; }
.media-tag {
  display: inline-block;
  background: #EEF2FF;
  color: #5B6BCE;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.feedback {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2A2A2A;
  white-space: pre-wrap;
}
