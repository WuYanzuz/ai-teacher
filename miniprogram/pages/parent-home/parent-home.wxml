<view class="container">
  <view class="card join-card" bindtap="onJoinClass">
    <view class="row">
      <view class="col">
        <view class="title">➕ 加入新班级</view>
        <view class="subtitle">输入老师给的 6 位加入码</view>
      </view>
      <view style="font-size:60rpx;color:#7C9CF1;">→</view>
    </view>
  </view>

  <view class="title" style="margin-top:40rpx;">我加入的班级</view>

  <view wx:if="{{!classes.length}}" class="empty">还没有加入任何班级</view>

  <view wx:for="{{classes}}" wx:key="id" class="card class-card">
    <view class="row" bindtap="onOpenClass" data-id="{{item.id}}">
      <view class="col">
        <view class="title">{{item.name}}</view>
        <view class="subtitle">老师: {{item.teacher_name}}</view>
        <view wx:if="{{item.child_name}}" class="subtitle" style="color:#7C9CF1;">宝宝: {{item.child_name}}</view>
      </view>
      <view style="font-size:60rpx;color:#7C9CF1;">→</view>
    </view>
    <view class="divider"></view>
    <view class="row">
      <view class="btn-secondary" style="flex:1;" data-class-id="{{item.id}}" data-child-name="{{item.child_name}}" bindtap="onChildReport">成长报告</view>
    </view>
  </view>

  <view class="card" style="margin-top:60rpx;text-align:center;" bindtap="onLogout">
    <text style="color:#9CA3AF;">退出登录</text>
  </view>
</view>
